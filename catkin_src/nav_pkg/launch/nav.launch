<launch>

    <arg name="map_file" default="$(find wpr_simulation)/maps/map.yaml"/>
    <arg name="initial_pose_x" default="6.75"/>
    <arg name="initial_pose_y" default="0.35"/>
    <arg name="initial_pose_a" default="1.5708"/>

    <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml" command="load" ns="local_costmap" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/global_costmap_params.yaml" command="load" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_planner_params.yaml" command="load" />
        <param name="base_global_planner" value="global_planner/GlobalPlanner" />
        <param name="use_dijkstra" value="true"/>
        <param name="base_local_planner" value="wpbh_local_planner/WpbhLocalPlanner" />
        <param name="controller_frequency" value="10" type="double"/>
        <param name="oscillation_timeout" value="8" type="double"/>
        <param name="oscillation_distance" value="0.2" type="double"/>
    </node>
    <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)"/>
    <param name="/amcl/initial_pose_x" value="$(arg initial_pose_x)" type="double"/>
    <param name="/amcl/initial_pose_y" value="$(arg initial_pose_y)" type="double"/>
    <param name="/amcl/initial_pose_a" value="$(arg initial_pose_a)" type="double"/>
    <include file="$(find wpb_home_tutorials)/nav_lidar/amcl_omni.launch"/>
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find nav_pkg)/rviz/nav.rviz" />
</launch>
