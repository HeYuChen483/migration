<launch>
  <arg name="config" default="$(find garbage_localization)/config/default.yaml"/>
  <arg name="detection_topic" default="/vision/fused_detections"/>
  <arg name="point_cloud_topic" default="/kinect2/sd/points"/>
  <arg name="camera_info_topic" default="/kinect2/hd/camera_info"/>
  <arg name="output_topic" default="/garbage_localization/objects"/>
  <arg name="output_frame" default="base_link"/>
  <arg name="rgb_frame" default="kinect2_rgb_optical_frame"/>

  <node pkg="garbage_localization" type="garbage_localization_node"
        name="garbage_localization" output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="detection_topic" value="$(arg detection_topic)"/>
    <param name="point_cloud_topic" value="$(arg point_cloud_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="output_topic" value="$(arg output_topic)"/>
    <param name="output_frame" value="$(arg output_frame)"/>
    <param name="rgb_frame" value="$(arg rgb_frame)"/>
  </node>
</launch>
